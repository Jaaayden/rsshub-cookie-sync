[Unit]
Description=RSSHub Cookie synchronization and health monitor
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=15min
TimeoutStopSec=30s
ExecStart=/usr/bin/python3 /usr/local/lib/rsshub-cookie-sync/rsshub_cookie_sync.py --config /etc/rsshub-cookie-sync/config.json monitor
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
